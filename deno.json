{
	"fmt": {
		"lineWidth": 80,
		"semiColons": false,
		"singleQuote": true,
		"useTabs": true
	},
	"imports": {
		"@gaia": "./gaia.js",
		"@gemini": "https://esm.sh/@google/genai"
	},
	"lock": false,
	"tasks": {
		"polish": "deno fmt && deno lint && deno check",
		"serve": "deno run --allow-net --allow-read jsr:@std/http/file-server ./"
	}
}
